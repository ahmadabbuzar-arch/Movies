{
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    },
    "api/providers.js": {
      "maxDuration": 10,
      "includeFiles": "providers/**"
    },
    "api/daily.js": {
      "maxDuration": 30
    },
    "api/provider-configs.js": {
      "maxDuration": 10,
      "includeFiles": "api/_provider-configs/**,api/_provider-adapters/**"
    },
    "api/provider-resolve.js": {
      "maxDuration": 30,
      "includeFiles": "api/_provider-configs/**,api/_provider-adapters/**"
    }
  },
  "headers": [
    {
      "source": "/providers/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/blocked.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "30 14 * * *"
    }
  ]
}
